       <Trigger Property="IsChecked" Value="True"><Setter TargetName="DisclosureChevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter><Setter TargetName="DisclosureChevron" Property="Stroke" Value="{DynamicResource AccentBrush}"/></Trigger>
