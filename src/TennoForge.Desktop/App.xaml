     </Border>
     <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-1" VerticalOffset="-5" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
